<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Chi Siamo — Cereria Cicogna</title>
  <meta name="description" content="Tre generazioni di cerai a Novate Milanese. Filippo e Fabio Cicogna portano avanti una tradizione liturgica e artigianale costruita nel tempo, tra le chiese dell'Italia del Nord e i tavoli dei migliori ristoranti.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="css/main.css?v=8">
  <style>

    /* ── ABOUT HERO ─────────────────────────── */
    .about-hero {
      min-height: 72vh;
      display: flex;
      align-items: flex-end;
      padding: 0 var(--gutter) 88px;
      position: relative;
      overflow: hidden;
      background: var(--c-dark);
    }

    .about-hero-bg {
      position: absolute;
      inset: 0;
      z-index: 0;
    }

    .about-hero-bg img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.18;
      display: block;
    }

    .about-hero-bg::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(13,10,5,1) 0%, rgba(13,10,5,.7) 50%, rgba(13,10,5,.3) 100%);
    }

    .about-hero-content {
      position: relative;
      z-index: 2;
      max-width: 740px;
    }

    .about-hero-eyebrow {
      display: block;
      font-family: var(--ff-sans);
      font-size: .54rem;
      font-weight: 300;
      letter-spacing: .32em;
      text-transform: uppercase;
      color: var(--c-gold);
      margin-bottom: 22px;
    }

    .about-hero-title {
      font-family: var(--ff-display);
      font-size: clamp(2.8rem, 7vw, 5.5rem);
      font-weight: 300;
      letter-spacing: .14em;
      color: var(--c-vellum);
      line-height: 1.1;
      margin-bottom: 28px;
    }

    .about-hero-lead {
      font-family: var(--ff-serif);
      font-style: italic;
      font-size: clamp(1.05rem, 2.5vw, 1.4rem);
      font-weight: 300;
      color: var(--c-stone);
      line-height: 1.8;
      max-width: 560px;
    }

    /* ── ABOUT BODY ─────────────────────────── */
    .about-body {
      background: var(--c-bg-light);
      color: var(--c-text-dark);
    }

    /* Story section */
    .about-story {
      max-width: 1280px;
      margin: 0 auto;
      padding: 96px var(--gutter);
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 80px;
      align-items: center;
    }

    .about-story-text {}

    .about-story-eyebrow {
      display: block;
      font-family: var(--ff-sans);
      font-size: .52rem;
      font-weight: 300;
      letter-spacing: .3em;
      text-transform: uppercase;
      color: var(--c-text-mid);
      margin-bottom: 20px;
    }

    .about-story-title {
      font-family: var(--ff-display);
      font-size: clamp(2rem, 4vw, 3.2rem);
      font-weight: 300;
      letter-spacing: .1em;
      color: var(--c-text-dark);
      line-height: 1.2;
      margin-bottom: 28px;
    }

    .about-story-title em {
      font-style: italic;
      color: var(--c-text-mid);
    }

    .about-story-body {
      font-family: var(--ff-serif);
      font-size: 1.08rem;
      line-height: 1.95;
      color: var(--c-text-mid);
    }

    .about-story-body + .about-story-body {
      margin-top: 16px;
    }

    .about-story-visual {
      position: relative;
    }

    .about-story-img {
      width: 100%;
      aspect-ratio: 4 / 5;
      object-fit: cover;
      display: block;
    }

    .about-story-img-caption {
      position: absolute;
      bottom: -14px;
      right: -14px;
      background: var(--c-bg-light);
      border: 1px solid rgba(26,22,18,.1);
      padding: 16px 22px;
    }

    .about-story-img-caption strong {
      display: block;
      font-family: var(--ff-display);
      font-size: 1.8rem;
      font-weight: 300;
      letter-spacing: .08em;
      color: var(--c-text-dark);
      line-height: 1;
    }

    .about-story-img-caption span {
      font-family: var(--ff-sans);
      font-size: .48rem;
      font-weight: 300;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--c-text-mid);
      display: block;
      margin-top: 4px;
    }

    /* Values grid */
    .about-values {
      background: var(--c-bg-cream);
      padding: 80px var(--gutter);
    }

    .about-values-inner {
      max-width: 1280px;
      margin: 0 auto;
    }

    .about-values-header {
      text-align: center;
      margin-bottom: 64px;
    }

    .about-values-title {
      font-family: var(--ff-display);
      font-size: clamp(1.6rem, 3.5vw, 2.8rem);
      font-weight: 300;
      letter-spacing: .12em;
      color: var(--c-text-dark);
    }

    .about-values-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 2px;
    }

    .about-value-item {
      background: var(--c-bg-light);
      padding: 48px 44px;
    }

    .about-value-icon {
      font-size: .6rem;
      letter-spacing: .4em;
      color: var(--c-gold);
      margin-bottom: 20px;
      display: block;
    }

    .about-value-title {
      font-family: var(--ff-display);
      font-size: 1.3rem;
      font-weight: 300;
      letter-spacing: .1em;
      color: var(--c-text-dark);
      margin-bottom: 14px;
      line-height: 1.3;
    }

    .about-value-desc {
      font-family: var(--ff-serif);
      font-size: 1rem;
      line-height: 1.85;
      color: var(--c-text-mid);
    }

    /* Quote section */
    .about-quote-section {
      background: var(--c-dark);
      padding: 100px var(--gutter);
      text-align: center;
    }

    .about-quote {
      font-family: var(--ff-serif);
      font-style: italic;
      font-size: clamp(1.2rem, 3vw, 2rem);
      font-weight: 300;
      color: var(--c-vellum);
      line-height: 1.85;
      max-width: 800px;
      margin: 0 auto 28px;
    }

    .about-quote em {
      font-style: normal;
      color: var(--c-gold-lt);
    }

    .about-quote-rule {
      width: 28px; height: 1px;
      background: var(--c-gold);
      margin: 0 auto 20px;
      opacity: .4;
    }

    .about-quote-attr {
      font-family: var(--ff-sans);
      font-size: .52rem;
      font-weight: 300;
      letter-spacing: .28em;
      text-transform: uppercase;
      color: var(--c-muted);
    }

    /* Products section */
    .about-products {
      background: var(--c-bg-light);
      padding: 80px var(--gutter);
      max-width: 1280px;
      margin: 0 auto;
    }

    .about-products-title {
      font-family: var(--ff-display);
      font-size: clamp(1.6rem, 3.5vw, 2.8rem);
      font-weight: 300;
      letter-spacing: .1em;
      color: var(--c-text-dark);
      text-align: center;
      margin-bottom: 56px;
    }

    .about-products-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 3px;
    }

    .about-product-card {
      position: relative;
      overflow: hidden;
      background: var(--c-bg-cream);
    }

    .about-product-card img {
      width: 100%;
      aspect-ratio: 1;
      object-fit: cover;
      display: block;
      transition: transform .9s cubic-bezier(.25,.46,.45,.94);
    }

    .about-product-card:hover img { transform: scale(1.06); }

    .about-product-card-label {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      padding: 28px 24px;
      background: linear-gradient(to top, rgba(26,22,18,.85), transparent);
    }

    .about-product-card-label span {
      font-family: var(--ff-display);
      font-size: 1rem;
      font-weight: 300;
      letter-spacing: .1em;
      color: var(--c-vellum);
      display: block;
    }

    .about-product-card-label a {
      font-family: var(--ff-sans);
      font-size: .5rem;
      font-weight: 300;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--c-stone);
      text-decoration: none;
      margin-top: 6px;
      display: inline-block;
      transition: color .3s;
    }
    .about-product-card:hover .about-product-card-label a { color: var(--c-vellum); }

    /* Responsive */
    @media (max-width: 1024px) {
      .about-story { grid-template-columns: 1fr; }
      .about-story-visual { order: -1; }
      .about-story-img { aspect-ratio: 16/9; }
      .about-values-grid { grid-template-columns: 1fr 1fr; }
      .about-products-grid { grid-template-columns: 1fr 1fr; }
    }

    @media (max-width: 640px) {
      .about-values-grid { grid-template-columns: 1fr; gap: 2px; }
      .about-products-grid { grid-template-columns: 1fr; }
    }

    /* Light nav */
    nav.scrolled { background: rgba(13,10,5,.93); }
  </style>
</head>
