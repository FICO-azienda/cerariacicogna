# ─────────────────────────────────────────────────────────────
# Copiare questo file in  assistant/.env  e compilarlo.
# .env non va mai messo online ne' committato: contiene la chiave.
# ─────────────────────────────────────────────────────────────

# OBBLIGATORIA — chiave API Anthropic, uso lato server.
# Va creata su console.anthropic.com. E' a consumo: e' un'altra cosa
# rispetto all'abbonamento Claude.
ANTHROPIC_API_KEY=sk-ant-...

# Indirizzo verso cui l'assistente prepara le bozze di email.
CC_EMAIL_SUPPORTO=info@cerariacicogna.com

# ── modello ──────────────────────────────────────────────────
# CC_MODELLO=claude-opus-5
# effort: low (rapido, per una chat) | medium | high | xhigh | max
# CC_EFFORT=low
# CC_MAX_TOKENS=2000

# ── tetti di spesa ───────────────────────────────────────────
# CC_MAX_MSG_ORA=30
# CC_MAX_MSG_SESSIONE=40
# CC_MAX_CARATTERI=2000
# CC_MAX_TURNI=20

# ── rete ─────────────────────────────────────────────────────
# PORT=8787
# Domini ammessi a chiamare l'API, separati da virgola.
# Vuoto = tutti (comodo in sviluppo, da restringere in produzione).
# CC_ORIGINI=https://www.cerariacicogna.com,https://cerariacicogna.com

# ── log ──────────────────────────────────────────────────────
# CC_LOG=true
# Su un server tuo: percorso file. Su Vercel lasciare vuoto (va su stdout).
# CC_LOG_FILE=./conversazioni.jsonl

# ── promemoria di riacquisto ─────────────────────────────────
# OBBLIGATORIA per far funzionare il pannello admin (admin.html) e i
# collegamenti di riordino/disiscrizione: una stringa lunga e casuale,
# usata per firmare le sessioni admin. Generarla una volta, es. con
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CC_TOKEN_SECRET=

# Password del pannello admin (assistant/src/admin/). Una sola chiave
# condivisa, non un utente per persona: vedi assistant/src/admin/auth.mjs.
# CC_ADMIN_PASSWORD=

# Segreto per il trigger esterno del ciclo giornaliero (vedi
# .github/workflows/promemoria.yml e api/cron/promemoria.js). Deve
# combaciare col secret CRON_SECRET del repository GitHub.
# CC_CRON_SECRET=

# ── posta: invio del modulo contatti + conferma al cliente ───
# Finche' queste due righe restano vuote, il modulo funziona come prima
# (apre il programma di posta del visitatore) e NON parte alcuna conferma.
#
# 1. Crea un account su resend.com (gratuito fino a 3.000 email/mese)
# 2. Verifica il dominio cerariacicogna.com aggiungendo i record DNS che
#    ti indica Resend. Senza questo passaggio le email partono ma
#    finiscono quasi sempre in spam.
# 3. Incolla qui la chiave e il mittente verificato.
# CC_RESEND_KEY=re_...
# CC_MITTENTE=Cereria Cicogna <no-reply@cerariacicogna.com>
# CC_DOMINIO=cerariacicogna.com
# Quante richieste puo' inviare lo stesso visitatore in un'ora
# CC_MAX_INVII_ORA=5
